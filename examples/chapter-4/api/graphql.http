### Error: Not Allowed
# Signed in as the other contractor, who doesn't own this profile.
# Expect: 400
POST {{baseUrl}}/graphql
Authorization: Bearer second-contractor-token
X-Request-Type: GraphQL

mutation UpdateContractorProfile($contractorId: ID!, $input: UpdateContractorProfileInput!) {
  updateContractorProfile(contractorId: $contractorId, input: $input) {
    availability
  }
}

{
  "contractorId": "c_8f3a2b",
  "input": {
    "availability": "BOOKED"
  }
}

# Response: 400 Bad Request
#
# {
#   "data": null,
#   "errors": [
#     {
#       "message": "Only the profile's owner can change it.",
#       "locations": [
#         {
#           "line": 2,
#           "column": 3
#         }
#       ],
#       "path": ["updateContractorProfile"],
#       "extensions": {
#         "code": "FORBIDDEN"
#       }
#     }
#   ]
# }

