### Error: Already Exists
# Each user can have one contractor profile.
# Expect: 400
POST {{baseUrl}}/graphql
Authorization: Bearer contractor-token
X-Request-Type: GraphQL

mutation CreateContractorProfile($input: CreateContractorProfileInput!) {
  createContractorProfile(input: $input) {
    contractorId
  }
}

{
  "input": {
    "companyName": "Acme Renovations West",
    "services": ["Painting"],
    "serviceArea": "Pasadena, CA",
    "availability": "OPEN"
  }
}

# Response: 400 Bad Request
#
# {
#   "data": null,
#   "errors": [
#     {
#       "message": "You already have a contractor profile: c_8f3a2b.",
#       "locations": [
#         {
#           "line": 2,
#           "column": 3
#         }
#       ],
#       "path": ["createContractorProfile"],
#       "extensions": {
#         "code": "ALREADY_EXISTS"
#       }
#     }
#   ]
# }

### Error: Idempotency Key Reused
# The same key with a different request. Use a new key for each new request.
# Expect: 400
POST {{baseUrl}}/graphql
Authorization: Bearer homeowner-token
Idempotency-Key: 5b0f3c1e-8a4d-4f7e-9c2b-1d6e7a8f9b30
X-Request-Type: GraphQL

mutation CreateReview($contractorId: ID!, $input: CreateReviewInput!) {
  createReview(contractorId: $contractorId, input: $input) {
    authorName
    body
    rating
  }
}

{
  "contractorId": "c_8f3a2b",
  "input": {
    "rating": 4,
    "body": "They found the leak behind the tile and fixed it the same day."
  }
}

# Response: 400 Bad Request
#
# {
#   "data": null,
#   "errors": [
#     {
#       "message": "This idempotency key was already used for a different request. Use a new key for each new request.",
#       "locations": [
#         {
#           "line": 2,
#           "column": 3
#         }
#       ],
#       "path": ["createReview"],
#       "extensions": {
#         "code": "IDEMPOTENCY_KEY_REUSED"
#       }
#     }
#   ]
# }

### Delete Contractor Profile
# Returns the ID of the deleted profile.
# Expect: 200
POST {{baseUrl}}/graphql
Authorization: Bearer second-contractor-token
X-Request-Type: GraphQL

mutation DeleteContractorProfile($contractorId: ID!) {
  deleteContractorProfile(contractorId: $contractorId)
}

{
  "contractorId": "c_51d2e0"
}

# Response: 200 OK
#
# {
#   "data": {
#     "deleteContractorProfile": "c_51d2e0"
#   }
# }
